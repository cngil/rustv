// Screensaver: generated animation with the time on top. Everything is computed
// from the clock, so it needs no images, no network and no setup.
// The time drifts slowly around the screen so nothing stays in one place long
// enough to burn into the panel.

export component Screensaver inherits Rectangle {
    // "aurora", "orbits" or "clock".
    in property <string> style: "aurora";
    in property <string> time;
    in property <string> date;
    in property <bool> show-clock: true;
    in property <bool> show-date: true;
    in property <float> s: 1;
    // Seconds since the screensaver started; drives every animation. The shell
    // advances it at a modest frame rate instead of redrawing at the display's
    // full rate, which keeps the GPU mostly idle.
    in property <float> t;

    background: black;

    property <bool> big-clock: root.style == "clock";

    // Soft colored lights drifting across each other.
    if root.style == "aurora": Rectangle {
        for i in 5: Rectangle {
            property <float> speed: 0.045 + i * 0.011;
            property <length> size: root.height * (0.75 + 0.15 * Math.sin((root.t * 0.06 + i * 1.3) * 1rad));
            property <color> tint: Colors.hsv(Math.mod(root.t * 3 + i * 72, 360), 0.8, 0.85);
            x: root.width * (0.5 + 0.4 * Math.sin((root.t * speed + i * 1.7) * 1rad)) - self.size / 2;
            y: root.height * (0.5 + 0.36 * Math.cos((root.t * speed * 1.3 + i * 2.3) * 1rad)) - self.size / 2;
            width: self.size;
            height: self.size;
            border-radius: self.size / 2;
            background: @radial-gradient(circle, self.tint.transparentize(0.45) 0%, self.tint.transparentize(0.8) 35%, self.tint.transparentize(1) 70%);
        }
    }

    // A slowly turning galaxy of points; inner rings turn faster.
    if root.style == "orbits": Rectangle {
        for i in 72: Rectangle {
            property <float> ring: Math.mod(i * 7, 12) / 12;
            property <angle> a: (root.t * (0.32 - self.ring * 0.24) + i * 2.399) * 1rad;
            property <float> radius: 0.07 + self.ring * 0.44;
            property <length> dot: (2 + Math.mod(i * 5, 6)) * 1.5px * root.s;
            x: root.width / 2 + root.height * self.radius * 1.3 * Math.cos(self.a) - self.dot / 2;
            y: root.height / 2 + root.height * self.radius * 0.78 * Math.sin(self.a) - self.dot / 2;
            width: self.dot;
            height: self.dot;
            border-radius: self.dot / 2;
            background: Colors.hsv(Math.mod(190 + self.ring * 150 + root.t * 2, 360), 0.5, 1);
            opacity: 0.3 + 0.7 * (1 - self.ring);
        }
    }

    // Time and date, wandering on a slow Lissajous path.
    if root.show-clock || root.show-date: Rectangle {
        width: column.preferred-width;
        height: column.preferred-height;
        x: (root.width - self.width) * (0.5 + 0.42 * Math.sin(root.t * 0.011 * 1rad));
        y: (root.height - self.height) * (0.5 + 0.4 * Math.cos(root.t * 0.017 * 1rad));

        column := VerticalLayout {
            spacing: 8px * root.s;
            if root.show-clock: Text {
                text: root.time;
                color: white;
                opacity: 0.92;
                font-size: (root.big-clock ? 220px : 150px) * root.s;
                font-weight: 700;
                horizontal-alignment: center;
            }
            if root.show-date: Text {
                text: root.date;
                color: #c8cede;
                opacity: 0.8;
                font-size: (root.big-clock ? 44px : 36px) * root.s;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
    }
}
