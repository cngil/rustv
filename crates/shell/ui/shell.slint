// rustv home screen. Designed for 1920x1080 and scaled to the real output.
// Navigation works with arrow keys and Enter (the remote's D-pad); no pointer needed.

import "fonts/HankenGrotesk-Regular.ttf";
import "fonts/HankenGrotesk-Medium.ttf";
import "fonts/HankenGrotesk-SemiBold.ttf";
import "fonts/HankenGrotesk-Bold.ttf";
import { Screensaver } from "screensaver.slint";
import { Palette, KeyCap } from "palette.slint";
import { SettingsView, SettingRow } from "settings.slint";

// The palette is set from Rust, so it is exported from here too.
export { Palette }

// Every piece of text on the home screen; the shell fills these in per language.
export global Strings {
    in property <string> subtitle: "What would you like to watch?";
    in property <string> no-apps: "No apps yet. Add some to ~/.config/rustv/config.toml";
    in property <string> hint-move: "Move";
    in property <string> hint-open: "Open";
    in property <string> opening: "Opening…";
    in property <string> connecting: "Connecting to tvd…";
    in property <string> volume: "Volume";
    in property <string> muted: "Muted";
    in property <string> pair-title: "Use your phone as the remote";
    in property <string> pair-body: "Scan the code with the camera, then add the page to your home screen.";
    in property <string> locked: "Locked";
    in property <string> unlock-hint: "Enter the PIN on your phone to unlock.";
    in property <string> settings: "Settings";
    in property <string> hint-change: "Change";
    in property <string> hint-select: "Select";
    in property <string> hint-close: "Close";
    in property <string> back-key: "Back";
}

export struct AppTile {
    id: string,
    name: string,
    // First letter, shown when the app has no icon.
    initial: string,
    icon: image,
    has-icon: bool,
    // The Settings tile at the end of the row, drawn with a gear.
    settings: bool,
}

component Card inherits Rectangle {
    in property <AppTile> tile;
    in property <bool> focused;
    in property <bool> opening;
    in property <float> s;
    callback activated();

    property <length> grow: focused ? 24px * s : 0px;
    animate grow { duration: 220ms; easing: cubic-bezier(0.16, 1, 0.3, 1); }

    // The face grows around the slot when focused, so neighbours do not move.
    // Focused, it is the lit plate: solid metal with dark ink. Otherwise matte graphite.
    face := Rectangle {
        x: -grow / 2;
        y: -grow / 2;
        width: root.width + grow;
        height: root.height + grow;
        border-radius: 28px * s;
        background: focused ? Palette.accent : Palette.surface;
        drop-shadow-offset-y: focused ? 22px * s : 0px;
        drop-shadow-blur: focused ? 44px * s : 0px;
        drop-shadow-color: #00000080;
        animate background { duration: 220ms; easing: ease-out; }
    }

    VerticalLayout {
        x: face.x;
        y: face.y;
        width: face.width;
        height: face.height;
        alignment: center;
        spacing: 24px * s;
        padding: 24px * s;

        HorizontalLayout {
            alignment: center;
            if tile.settings: Rectangle {
                width: 112px * s;
                height: 112px * s;
                border-radius: 28px * s;
                background: focused ? Palette.on-accent.transparentize(0.9) : Palette.surface-3;
                animate background { duration: 220ms; easing: ease-out; }
                Path {
                    width: 60px * s;
                    height: 60px * s;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    fill: transparent;
                    stroke: focused ? Palette.on-accent : Palette.accent;
                    stroke-width: 1.6px * s;
                    commands: "M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 0 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 0 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 0 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 0 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z";
                }
            }
            if tile.has-icon: Image {
                source: tile.icon;
                width: 112px * s;
                height: 112px * s;
                image-fit: contain;
            }
            // No icon: the initial, engraved in graphite (and in the plate's ink when focused).
            if !tile.has-icon && !tile.settings: Rectangle {
                width: 112px * s;
                height: 112px * s;
                border-radius: 28px * s;
                background: focused ? Palette.on-accent.transparentize(0.9) : Palette.surface-3;
                animate background { duration: 220ms; easing: ease-out; }
                Text {
                    text: tile.initial;
                    color: focused ? Palette.on-accent : Palette.accent;
                    font-size: 52px * s;
                    font-weight: 600;
                }
            }
        }

        Text {
            text: opening ? Strings.opening : tile.name;
            color: focused ? Palette.on-accent : Palette.muted;
            font-size: 30px * s;
            font-weight: focused ? 600 : 500;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        mouse-cursor: none;
        clicked => { root.activated(); }
    }
}

export component Shell inherits Window {
    title: "rustv";
    background: Palette.background;
    default-font-family: "Hanken Grotesk";
    preferred-width: 1920px;
    preferred-height: 1080px;

    in property <[AppTile]> apps;
    in property <string> time: "00:00";
    in property <string> date;
    in property <string> greeting: "Welcome";
    in property <bool> connected;
    in property <string> opening-id;
    in property <float> volume;
    in property <float> max-volume: 1.5;
    in property <bool> muted;
    in property <bool> osd-visible;
    in-out property <int> selected: 0;

    // Toggles from the [shell] section of the config.
    in property <bool> show-greeting: true;
    in property <bool> show-clock: true;
    in property <bool> show-date: true;
    in property <bool> show-hints: true;
    in property <bool> show-volume-overlay: true;

    // Screensaver, started by the shell after a while without input on the home screen.
    in-out property <bool> screensaver-active;
    in property <string> screensaver-style: "aurora";
    in property <bool> screensaver-clock: true;
    in property <bool> screensaver-date: true;
    in property <float> screensaver-time;
    // The `images` screensaver: the current picture fades in over the one before.
    in property <image> photo;
    in property <image> photo-before;
    in property <float> photo-since;
    in property <float> slide-seconds: 30;

    // Your own pictures behind the home screen. Two layers, so a new one crossfades in.
    in property <bool> wallpaper-on;
    in property <image> wallpaper-a;
    in property <image> wallpaper-b;
    in property <bool> wallpaper-b-front;

    // Pairing card: tvd decides when it shows (until the first remote connects, and on request).
    in property <bool> show-pairing;
    in property <image> pairing-qr;
    in property <string> pairing-url;

    // Locked with the PIN: the home screen is hidden and keys do nothing.
    in property <bool> locked;

    // Settings on the TV, drawn from rows the shell works out (menu.rs).
    in-out property <bool> settings-open;
    in property <bool> settings-enabled: true;
    in property <[SettingRow]> settings-rows;
    in property <float> settings-scroll;
    in property <string> settings-hint;
    // "up", "down", "left", "right", "ok" or "back".
    callback settings-key(string);
    callback open-settings();

    callback launch(string);
    // UI sound: "move", "select" or "edge".
    callback sound(string);
    // Any key or pointer movement; resets the screensaver timer.
    callback activity();

    property <float> s: min(root.width / 1920px, root.height / 1080px);
    property <length> slot-width: 300px * s;
    property <length> slot-height: 264px * s;
    property <length> gap: 32px * s;
    property <length> margin: 112px * s;

    function activate(index: int) {
        if index >= 0 && index < apps.length {
            root.selected = index;
            root.sound("select");
            root.launch(apps[index].id);
        }
    }

    // Moves the focus by `step` cards, with a sound; a softer one at either end.
    function move(step: int) {
        let target = max(0, min(root.apps.length - 1, root.selected + step));
        if target == root.selected {
            root.sound("edge");
        } else {
            root.selected = target;
            root.sound("move");
        }
    }

    // Background: flat graphite (the window's own color); your pictures go over it.
    if root.wallpaper-on: Rectangle {
        Image {
            width: parent.width;
            height: parent.height;
            source: root.wallpaper-a;
            image-fit: cover;
            opacity: root.wallpaper-b-front ? 0 : 1;
            animate opacity { duration: 1500ms; easing: ease-in-out; }
        }
        Image {
            width: parent.width;
            height: parent.height;
            source: root.wallpaper-b;
            image-fit: cover;
            opacity: root.wallpaper-b-front ? 1 : 0;
            animate opacity { duration: 1500ms; easing: ease-in-out; }
        }
        // Darker at the top and bottom, where the clock, the greeting and the hints are.
        Rectangle {
            background: @linear-gradient(180deg, #000000b8 0%, #00000058 40%, #00000066 65%, #000000c8 100%);
        }
    }

    // Hides the pointer everywhere; cards still react to clicks.
    TouchArea {
        mouse-cursor: none;
        pointer-event(event) => { root.activity(); }
    }

    // Header: greeting on the left, the time on the right, sharing one top line.
    Text {
        visible: root.show-greeting;
        x: margin;
        y: 96px * s;
        text: root.greeting;
        color: Palette.text;
        font-size: 52px * s;
        font-weight: 600;
        letter-spacing: -0.5px * s;
    }
    Text {
        visible: root.show-greeting;
        x: margin;
        y: 172px * s;
        text: Strings.subtitle;
        color: Palette.muted;
        font-size: 28px * s;
    }
    Text {
        visible: root.show-clock;
        x: root.width - self.width - margin;
        y: 74px * s;
        text: root.time;
        color: Palette.text;
        font-size: 88px * s;
        font-weight: 500;
        letter-spacing: -2px * s;
    }
    Text {
        visible: root.show-date;
        x: root.width - self.width - margin;
        y: root.show-clock ? 178px * s : 96px * s;
        text: root.date;
        color: Palette.muted;
        font-size: 28px * s;
    }

    // App row: from the left margin when it fits, otherwise it scrolls to keep the focused card visible.
    Rectangle {
        y: (root.height - slot-height) / 2 + 28px * s;
        height: slot-height;
        width: root.width;

        property <length> total: apps.length * slot-width + max(0, apps.length - 1) * gap;
        property <length> follow: root.width / 2 - (root.selected * (slot-width + gap) + slot-width / 2);

        Rectangle {
            // Starts at the margin, in line with the greeting; scrolls once it no longer fits.
            x: parent.total <= root.width - 2 * margin
                ? margin
                : max(min(margin, parent.follow), root.width - margin - parent.total);
            animate x { duration: 240ms; easing: ease-out; }
            width: parent.total;
            height: parent.height;

            for tile[index] in root.apps: Rectangle {
                x: index * (slot-width + gap);
                width: slot-width;
                height: slot-height;
                Card {
                    tile: tile;
                    s: root.s;
                    focused: index == root.selected;
                    opening: root.opening-id == tile.id;
                    activated => { root.activate(index); }
                }
            }
        }
    }

    // Only the Settings tile, or nothing at all: no apps configured yet.
    if apps.length - (root.settings-enabled ? 1 : 0) <= 0 && root.connected: Text {
        y: root.height / 2 - 230px * s;
        width: root.width;
        horizontal-alignment: center;
        text: Strings.no-apps;
        color: Palette.muted;
        font-size: 30px * s;
    }

    // Footer hints: keys drawn as small graphite caps.
    if root.show-hints: HorizontalLayout {
        x: margin;
        y: root.height - 88px * s - self.height;
        width: self.preferred-width;
        height: 44px * s;
        spacing: 40px * s;
        HorizontalLayout {
            spacing: 14px * s;
            KeyCap { label: "←  →"; s: root.s; }
            Text { text: Strings.hint-move; color: Palette.muted; font-size: 24px * s; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 14px * s;
            KeyCap { label: "OK"; s: root.s; }
            Text { text: Strings.hint-open; color: Palette.muted; font-size: 24px * s; vertical-alignment: center; }
        }
    }

    // Pairing card
    if root.show-pairing && !root.screensaver-active: Rectangle {
        x: root.width - self.width - margin;
        y: root.height - self.height - 72px * s;
        width: 660px * s;
        height: 232px * s;
        border-radius: 28px * s;
        background: Palette.surface;

        HorizontalLayout {
            padding: 24px * s;
            spacing: 28px * s;
            Rectangle {
                width: 184px * s;
                height: 184px * s;
                border-radius: 14px * s;
                background: white;
                Image {
                    // White frame is the quiet zone scanners need.
                    width: parent.width - 24px * s;
                    height: parent.height - 24px * s;
                    source: root.pairing-qr;
                    image-rendering: pixelated;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 10px * s;
                Text {
                    text: Strings.pair-title;
                    color: Palette.text;
                    font-size: 30px * s;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: Strings.pair-body;
                    color: Palette.muted;
                    font-size: 22px * s;
                    wrap: word-wrap;
                }
                Text {
                    text: root.pairing-url;
                    color: Palette.accent;
                    font-size: 20px * s;
                    font-weight: 500;
                }
            }
        }
    }

    // Connection banner
    Rectangle {
        visible: !root.connected;
        x: (root.width - self.width) / 2;
        y: 40px * s;
        width: banner-row.preferred-width + 64px * s;
        height: 60px * s;
        border-radius: self.height / 2;
        background: Palette.surface-2;
        banner-row := HorizontalLayout {
            alignment: center;
            spacing: 16px * s;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 12px * s;
                height: 12px * s;
                border-radius: self.width / 2;
                background: #e3b866;
            }
            Text {
                text: Strings.connecting;
                color: Palette.text;
                font-size: 24px * s;
                vertical-alignment: center;
            }
        }
    }

    if root.settings-open: SettingsView {
        rows: root.settings-rows;
        scroll: root.settings-scroll;
        hint: root.settings-hint;
        title: Strings.settings;
        hint-move: Strings.hint-move;
        hint-change: Strings.hint-change;
        hint-select: Strings.hint-select;
        hint-close: Strings.hint-close;
        back-key: Strings.back-key;
        s: root.s;
        TouchArea { mouse-cursor: none; }
    }

    // Volume overlay
    Rectangle {
        opacity: root.osd-visible && root.show-volume-overlay ? 1 : 0;
        animate opacity { duration: 200ms; }
        x: (root.width - self.width) / 2;
        y: root.height - 230px * s;
        width: 620px * s;
        height: 96px * s;
        border-radius: 28px * s;
        background: Palette.surface-2;
        drop-shadow-offset-y: 16px * s;
        drop-shadow-blur: 40px * s;
        drop-shadow-color: #00000080;

        HorizontalLayout {
            padding-left: 36px * s;
            padding-right: 36px * s;
            spacing: 28px * s;
            Text {
                vertical-alignment: center;
                text: root.muted ? Strings.muted : Strings.volume;
                color: Palette.muted;
                font-size: 26px * s;
                font-weight: 500;
                min-width: 120px * s;
            }
            Rectangle {
                Rectangle {
                    y: (parent.height - self.height) / 2;
                    height: 10px * s;
                    border-radius: self.height / 2;
                    background: Palette.surface-3;
                    Rectangle {
                        x: 0;
                        width: parent.width * clamp(root.volume / max(root.max-volume, 0.01), 0, 1);
                        animate width { duration: 120ms; }
                        border-radius: parent.border-radius;
                        background: root.muted ? Palette.muted : Palette.accent;
                    }
                }
            }
            Text {
                vertical-alignment: center;
                horizontal-alignment: right;
                text: Math.round(root.volume * 100) + "%";
                color: Palette.text;
                font-size: 28px * s;
                font-weight: 600;
                min-width: 90px * s;
            }
        }
    }

    // Lock screen
    if root.locked: Rectangle {
        background: Palette.background;
        TouchArea { mouse-cursor: none; }
        VerticalLayout {
            alignment: center;
            spacing: 24px * s;
            HorizontalLayout {
                alignment: center;
                // A padlock: shackle over a body.
                Rectangle {
                    width: 120px * s;
                    height: 140px * s;
                    Rectangle {
                        x: 26px * s;
                        y: 0;
                        width: 68px * s;
                        height: 80px * s;
                        border-radius: 34px * s;
                        border-width: 12px * s;
                        border-color: Palette.muted;
                    }
                    Rectangle {
                        y: 56px * s;
                        height: 84px * s;
                        border-radius: 20px * s;
                        background: Palette.accent;
                    }
                }
            }
            Text {
                text: Strings.locked;
                color: Palette.text;
                font-size: 56px * s;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: Strings.unlock-hint;
                color: Palette.muted;
                font-size: 28px * s;
                horizontal-alignment: center;
            }
        }
    }

    if root.screensaver-active: Screensaver {
        style: root.screensaver-style;
        time: root.time;
        date: root.date;
        show-clock: root.screensaver-clock;
        show-date: root.screensaver-date;
        t: root.screensaver-time;
        s: root.s;
        photo: root.photo;
        photo-before: root.photo-before;
        photo-since: root.photo-since;
        slide-seconds: root.slide-seconds;
        opacity: 0;
        init => { self.opacity = 1; }
        animate opacity { duration: 1500ms; easing: ease-in-out; }

        TouchArea {
            mouse-cursor: none;
            pointer-event(event) => { root.screensaver-active = false; root.activity(); }
        }
    }

    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            root.activity();
            // The key that wakes the screen does nothing else.
            if root.screensaver-active {
                root.screensaver-active = false;
                return accept;
            }
            if root.locked {
                return accept;
            }
            if root.settings-open {
                if event.text == Key.UpArrow { root.settings-key("up"); }
                else if event.text == Key.DownArrow { root.settings-key("down"); }
                else if event.text == Key.LeftArrow { root.settings-key("left"); }
                else if event.text == Key.RightArrow { root.settings-key("right"); }
                else if event.text == Key.Return || event.text == " " { root.settings-key("ok"); }
                else if event.text == Key.Escape || event.text == Key.Backspace || event.text == Key.Menu { root.settings-key("back"); }
                return accept;
            }
            // The Menu key (the TV remote's Setup button over CEC) opens settings from the home screen.
            if event.text == Key.Menu && root.settings-enabled {
                root.open-settings();
                return accept;
            }
            if event.text == Key.LeftArrow {
                root.move(-1);
                return accept;
            }
            if event.text == Key.RightArrow {
                root.move(1);
                return accept;
            }
            if event.text == Key.Return || event.text == " " {
                root.activate(root.selected);
                return accept;
            }
            if event.text == Key.Home {
                root.move(-root.apps.length);
                return accept;
            }
            if event.text == Key.End {
                root.move(root.apps.length);
                return accept;
            }
            reject
        }
    }
}
